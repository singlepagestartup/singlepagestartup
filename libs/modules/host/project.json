    "jest:integration": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/coverage"
      ],
      "inputs": [
        "{projectRoot}/**/*",
        "^default"
      ],
      "options": {
        "command": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config ./libs/modules/host/jest.integration.config.ts --passWithNoTests",
        "cwd": ".",
        "env": {
          "TS_NODE_COMPILER_OPTIONS": "{\"moduleResolution\":\"node16\",\"module\":\"Node16\",\"customConditions\":null}"
        }
      }
    },
    "tsc:build": {},
