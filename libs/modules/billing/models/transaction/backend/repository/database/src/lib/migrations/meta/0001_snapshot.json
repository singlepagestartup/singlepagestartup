        "sps_bg_advance_maximum": {
          "name": "sps_bg_advance_maximum",
          "value": "\"sps_bg_transaction\".\"advance_amount\" >= 0 AND \"sps_bg_transaction\".\"advance_amount\" <= \"sps_bg_transaction\".\"amount\""
        },
        "sps_bg_wallet_amount_positive": {
          "name": "sps_bg_wallet_amount_positive",
          "value": "\"sps_bg_transaction\".\"amount\" > 0 AND (\"sps_bg_transaction\".\"budget\" IS NULL OR \"sps_bg_transaction\".\"budget\" >= \"sps_bg_transaction\".\"amount\")"
        },
        "sps_bg_wallet_distinct_parties": {
          "name": "sps_bg_wallet_distinct_parties",
          "value": "\"sps_bg_transaction\".\"sender_id\" <> \"sps_bg_transaction\".\"recipient_id\""
        },
        "sps_bg_wallet_valid_kind": {
          "name": "sps_bg_wallet_valid_kind",
          "value": "(\"sps_bg_transaction\".\"kind\" = 'reserve' AND \"sps_bg_transaction\".\"state\" IN ('held','released','settled')) OR (\"sps_bg_transaction\".\"kind\" = 'transfer' AND \"sps_bg_transaction\".\"state\" = 'posted' AND \"sps_bg_transaction\".\"budget\" IS NULL)"
