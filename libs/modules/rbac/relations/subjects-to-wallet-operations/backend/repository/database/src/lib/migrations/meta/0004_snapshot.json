      "checkConstraints": {
        "sps_rc_advance_maximum": {
          "name": "sps_rc_advance_maximum",
          "value": "\"sps_rc_wallet_operation\".\"advance_amount\" >= 0 AND \"sps_rc_wallet_operation\".\"advance_amount\" <= \"sps_rc_wallet_operation\".\"amount\""
        },
        "sps_rc_wallet_amount_positive": {
          "name": "sps_rc_wallet_amount_positive",
          "value": "\"sps_rc_wallet_operation\".\"amount\" > 0 AND (\"sps_rc_wallet_operation\".\"budget\" IS NULL OR \"sps_rc_wallet_operation\".\"budget\" >= \"sps_rc_wallet_operation\".\"amount\")"
        },
        "sps_rc_wallet_distinct_parties": {
          "name": "sps_rc_wallet_distinct_parties",
          "value": "\"sps_rc_wallet_operation\".\"sender_id\" <> \"sps_rc_wallet_operation\".\"recipient_id\""
        },
        "sps_rc_wallet_valid_kind": {
          "name": "sps_rc_wallet_valid_kind",
          "value": "(\"sps_rc_wallet_operation\".\"kind\" = 'reserve' AND \"sps_rc_wallet_operation\".\"state\" IN ('held','released','settled') AND \"sps_rc_wallet_operation\".\"budget\" IS NOT NULL) OR (\"sps_rc_wallet_operation\".\"kind\" = 'transfer' AND \"sps_rc_wallet_operation\".\"state\" = 'posted' AND \"sps_rc_wallet_operation\".\"budget\" IS NULL)"
        }
