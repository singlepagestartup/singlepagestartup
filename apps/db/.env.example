COMPOSE_PROJECT_NAME=singlepagestartup

POSTGRES_DB=sps
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_random_admin_password
POSTGRES_PORT=5432

# The role apps/api connects as, created by create_application_role.sh on the
# first start of an empty db_data. It owns POSTGRES_DB and is not a superuser.
DATABASE_USERNAME=sps
DATABASE_PASSWORD=replace_with_a_separate_random_app_password

ADMINER_PORT=8080
