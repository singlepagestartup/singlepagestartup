{
  "name": "SinglePageStartup Studio",
  "version": "0.1.0",
  "collections": [
    {
      "name": "SinglePageStartup Studio / Color",
      "modes": ["Light", "Dark"],
      "variables": [
        {
          "name": "color/background",
          "css": "var(--sps-color-background)",
          "light": "#f4f6f8",
          "dark": "#18232a",
          "scopes": ["FRAME_FILL", "SHAPE_FILL"]
        },
        {
          "name": "color/foreground",
          "css": "var(--sps-color-foreground)",
          "light": "#18232a",
          "dark": "#ffffff",
          "scopes": ["TEXT_FILL"]
        },
        {
          "name": "color/surface",
          "css": "var(--sps-color-surface)",
          "light": "#ffffff",
          "dark": "#18232a",
          "scopes": ["FRAME_FILL", "SHAPE_FILL"]
        },
        {
          "name": "color/border",
          "css": "var(--sps-color-border)",
          "light": "#dce2e6",
          "dark": "#5b6870",
          "scopes": ["STROKE_COLOR"]
        },
        {
          "name": "color/primary",
          "css": "var(--sps-color-primary)",
          "light": "#18232a",
          "dark": "#ffffff",
          "scopes": ["FRAME_FILL", "SHAPE_FILL", "TEXT_FILL"]
        },
        {
          "name": "color/secondary",
          "css": "var(--sps-color-secondary)",
          "light": "#ffffff",
          "dark": "#18232a",
          "scopes": ["FRAME_FILL", "SHAPE_FILL", "TEXT_FILL"]
        },
        {
          "name": "color/accent",
          "css": "var(--sps-color-accent)",
          "light": "#bfef61",
          "dark": "#bfef61",
          "scopes": ["FRAME_FILL", "SHAPE_FILL", "TEXT_FILL"]
        }
      ]
    },
    {
      "name": "SinglePageStartup Studio / Spacing",
      "modes": ["Value"],
      "variables": [
        {
          "name": "spacing/xs",
          "css": "var(--sps-space-xs)",
          "value": 8,
          "scopes": ["GAP"]
        },
        {
          "name": "spacing/md",
          "css": "var(--sps-space-md)",
          "value": 16,
          "scopes": ["GAP"]
        },
        {
          "name": "spacing/xl",
          "css": "var(--sps-space-xl)",
          "value": 32,
          "scopes": ["GAP"]
        }
      ]
    },
    {
      "name": "SinglePageStartup Studio / Radius",
      "modes": ["Value"],
      "variables": [
        {
          "name": "radius/md",
          "css": "var(--sps-radius-md)",
          "value": 8,
          "scopes": ["CORNER_RADIUS"]
        },
        {
          "name": "radius/lg",
          "css": "var(--sps-radius-lg)",
          "value": 12,
          "scopes": ["CORNER_RADIUS"]
        },
        {
          "name": "radius/xl",
          "css": "var(--sps-radius-xl)",
          "value": 16,
          "scopes": ["CORNER_RADIUS"]
        }
      ]
    }
