{
  "$schema": "https://singlepagestartup.local/schemas/studio/tokens.schema.json",
  "name": "singlepagestartup-studio-default",
  "version": "0.1.0",
  "modes": {
    "light": {
      "color": {
        "background": "#f4f6f8",
        "foreground": "#18232a",
        "surface": "#ffffff",
        "surfaceMuted": "#f4f6f8",
        "surfaceRaised": "#ffffff",
        "border": "#dce2e6",
        "borderStrong": "#5b6870",
        "primary": "#18232a",
        "primaryForeground": "#ffffff",
        "secondary": "#ffffff",
        "secondaryForeground": "#18232a",
        "accent": "#bfef61",
        "accentForeground": "#18232a",
        "muted": "#f4f6f8",
        "mutedForeground": "#5b6870",
        "danger": "#b42338"
      }
    },
    "dark": {
      "color": {
        "background": "#18232a",
        "foreground": "#ffffff",
        "surface": "#18232a",
        "surfaceMuted": "#18232a",
        "surfaceRaised": "#18232a",
        "border": "#5b6870",
        "borderStrong": "#c4cdd3",
        "primary": "#ffffff",
        "primaryForeground": "#18232a",
        "secondary": "#18232a",
        "secondaryForeground": "#ffffff",
        "accent": "#bfef61",
        "accentForeground": "#18232a",
        "muted": "#18232a",
        "mutedForeground": "#c4cdd3",
        "danger": "#b42338"
      }
    }
  },
  "spacing": {
    "2xs": "0.25rem",
    "xs": "0.5rem",
    "sm": "0.75rem",
    "md": "1rem",
    "lg": "1.5rem",
    "xl": "2rem",
    "2xl": "3rem",
    "3xl": "4rem",
    "4xl": "6rem"
  },
  "radius": {
    "sm": "0.375rem",
    "md": "0.5rem",
    "lg": "0.75rem",
    "xl": "1rem",
    "full": "9999px"
  },
  "typography": {
    "fontFamily": "Onest, ui-sans-serif, system-ui, sans-serif",
    "body": {
      "fontSize": "1rem",
      "lineHeight": "1.6"
    },
    "eyebrow": {
      "fontSize": "0.8125rem",
      "lineHeight": "1.4",
      "fontWeight": "700"
    },
    "heading": {
      "fontSize": "clamp(2.25rem, 5vw, 4.75rem)",
      "lineHeight": "1.02",
      "fontWeight": "750"
    },
    "subheading": {
      "fontSize": "clamp(1.125rem, 2vw, 1.375rem)",
      "lineHeight": "1.5",
      "fontWeight": "400"
    }
  },
  "shadow": {
    "sm": "0 1px 2px rgb(15 23 42 / 0.08)",
    "md": "0 12px 30px rgb(15 23 42 / 0.10)",
    "lg": "0 24px 70px rgb(15 23 42 / 0.14)"
  },
  "source": "apps/studio/workspace/styles/singlepage.css"
}
