{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "noEmit": true,
    "strict": true,
    "types": ["node", "bun"]
  },
  "include": [
    ".storybook/**/*.ts",
    "raw-imports.d.ts",
    "workspace/**/*.ts",
    "workspace/**/*.tsx",
    "workspace/**/*.jsx"
  ],
  "exclude": ["node_modules", "runnable/**"]
}
