{
  "compilerOptions": {
    "baseUrl": "../..",
    "paths": {
      "@sps/shared-frontend-client-utils/chat-scroll": [
        "libs/shared/frontend/client/utils/src/lib/chat-scroll/index.ts"
      ],
      "@sps/shared-utils/chat-scroll": [
        "libs/shared/utils/src/lib/constants/chat-scroll.ts"
      ],
      "@sps/ui-adapter/toast": [
        "libs/shared/ui/adapter/src/lib/toast/index.tsx"
      ]
    },
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "types": ["node", "bun"]
  },
  "include": [
    ".storybook/**/*.ts",
    "raw-imports.d.ts",
    "workspace/**/*.ts",
    "workspace/**/*.tsx",
    "workspace/**/*.jsx",
    "modules/**/*.ts",
    "modules/**/*.tsx"
  ],
  "exclude": ["node_modules", "runnable/**"]
}
