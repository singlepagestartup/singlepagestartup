{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "types": ["node", "bun"]
  },
  "include": [
    ".storybook/**/*.ts",
    "raw-imports.d.ts",
    "workspace/**/*.ts",
    "workspace/**/*.tsx",
    "workspace/**/*.jsx",
    "modules/**/*.ts",
    "modules/**/*.tsx"
  ],
  "exclude": ["node_modules", "runnable/**"]
}
