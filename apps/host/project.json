{
  "name": "host",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/host",
  "projectType": "application",
  "tags": [],
  "targets": {
    "jest:test": {},
    "next:dev": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/host",
        "command": "next dev --turbopack"
      }
    },
    "next:build": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "apps/host",
        "command": "next build --webpack"
      },
      "outputs": [
        "{projectRoot}/.next"
      ]
    },
    "next:start": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/host",
        "command": "next start"
      }
    },
    "next:export": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/host",
        "command": "next build --webpack",
        "env": {
          "SPS_HOST_STATIC_EXPORT": "true"
        }
      }
    },
    "eslint:lint": {}
  }
}
