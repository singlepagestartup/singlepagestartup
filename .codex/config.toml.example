# Shared Codex defaults; copy to the ignored .codex/config.toml.
# Project MCP connections are generated explicitly for the current checkout.

[agents]
max_threads = 6
max_depth = 2

[profiles.sps-safe]
approval_policy = "on-request"
sandbox_mode = "workspace-write"

[profiles.sps-auto]
approval_policy = "never"
sandbox_mode = "workspace-write"

[profiles.sps-readonly]
approval_policy = "never"
sandbox_mode = "read-only"
