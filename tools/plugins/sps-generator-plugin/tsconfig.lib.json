{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "types": [
      "node"
    ],
    "composite": true
  },
  "include": [
    "src/**/*.ts",
    "../../../libs/providers/db/src/**/*.ts",
    "../../../libs/shared/backend/database/config/src/**/*.ts",
    "../../../libs/shared/backend/utils/src/**/*.ts",
    "../../../libs/shared/configuration/src/**/*.ts",
    "../../../libs/shared/utils/src/**/*.ts"
  ],
  "exclude": [
