version: "3.7"

services:
  redis:
    image: redis
    command:
      - /bin/sh
      - -c
      - >-
        test -n "$${REDIS_PASSWORD}" &&
        exec redis-server
        --port "$${REDIS_PORT:-6379}"
        --requirepass "$${REDIS_PASSWORD}"
        --maxmemory "$${REDIS_MAXMEMORY:-256mb}"
        --maxmemory-policy "$${REDIS_MAXMEMORY_POLICY:-allkeys-lru}"
    volumes:
      - ./redis_data:/data
    networks:
      - traefik_overlay
    environment:
      REDIS_DATABASES: 16
      REDIS_PORT: {{ REDIS_PORT | default('6379', true) | to_json }}
      REDIS_PASSWORD: {{ REDIS_PASSWORD | to_json }}
      REDIS_MAXMEMORY: {{ REDIS_MAXMEMORY | default('256mb', true) | to_json }}
      REDIS_MAXMEMORY_POLICY: {{ REDIS_MAXMEMORY_POLICY | default('allkeys-lru', true) | to_json }}
    deploy:
      placement:
        constraints:
          - node.role == manager

networks:
  traefik_overlay:
    external: true
