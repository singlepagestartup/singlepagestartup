version: "3.7"

services:
  redis:
    image: redis
    command:
      - /bin/sh
      - -c
      - >-
        test -n "$${REDIS_PASSWORD}" &&
        exec redis-server
        --port "$${REDIS_PORT:-6379}"
        --requirepass "$${REDIS_PASSWORD}"
    volumes:
      - ./redis_data:/root/redis
    networks:
      - traefik_overlay
    environment:
      REDIS_DATABASES: 16
      REDIS_PORT: {{ REDIS_PORT | default('6379') }}
      REDIS_PASSWORD: {{ REDIS_PASSWORD | to_json }}
    healthcheck:
      test:
        - CMD-SHELL
        - >-
          REDISCLI_AUTH="$${REDIS_PASSWORD}"
          redis-cli
          -p "$${REDIS_PORT:-6379}"
          --no-auth-warning
          ping | grep -qx PONG
      interval: 5s
      timeout: 3s
      retries: 12
      start_period: 5s
    deploy:
      update_config:
        order: start-first
      placement:
        constraints:
          - node.role == manager

networks:
  traefik_overlay:
    external: true
