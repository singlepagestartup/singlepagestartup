version: "3.7"

services:
  traefik:
    image: traefik:v3.7
    ports:
      # Preserve the client address; Swarm ingress replaces it with a gateway.
      - target: 80
        published: 80
        protocol: tcp
        mode: host
      - target: 443
        published: 443
        protocol: tcp
        mode: host
    networks:
      - traefik_overlay
    command:
      - --log.level={{ TRAEFIK_LOG_LEVEL | default('INFO', true) }}
      # One JSON line per request on stdout, beside the Traefik log. Header
      # values are dropped because requests carry credentials in headers.
      - --accesslog=true
      - --accesslog.format=json
      - --accesslog.fields.headers.defaultmode=drop
      - --api
      - --providers.swarm=true
      - --providers.swarm.endpoint=unix:///var/run/docker.sock
      - --providers.swarm.exposedbydefault=false
      - --providers.swarm.network=traefik_overlay
      - --providers.file.directory=/etc/traefik/dynamic_conf
      - --providers.file.watch=true
      - --entrypoints.web.address=:80
      - --entrypoints.websecure.address=:443
{# Cloudflare source: https://www.cloudflare.com/ips/ (checked 2026-11-09). #}
{% if USE_CLOUDFLARE_SSL | default(false) | bool %}
      - --entrypoints.web.forwardedheaders.trustedips=103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,104.16.0.0/13,104.24.0.0/14,108.162.192.0/18,131.0.72.0/22,141.101.64.0/18,162.158.0.0/15,172.64.0.0/13,173.245.48.0/20,188.114.96.0/20,190.93.240.0/20,197.234.240.0/22,198.41.128.0/17,2400:cb00::/32,2606:4700::/32,2803:f800::/32,2405:b500::/32,2405:8100::/32,2a06:98c0::/29,2c0f:f248::/32
      - --entrypoints.websecure.forwardedheaders.trustedips=103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,104.16.0.0/13,104.24.0.0/14,108.162.192.0/18,131.0.72.0/22,141.101.64.0/18,162.158.0.0/15,172.64.0.0/13,173.245.48.0/20,188.114.96.0/20,190.93.240.0/20,197.234.240.0/22,198.41.128.0/17,2400:cb00::/32,2606:4700::/32,2803:f800::/32,2405:b500::/32,2405:8100::/32,2a06:98c0::/29,2c0f:f248::/32
{% endif %}
    volumes:
      - ./certs/:/certs/:ro
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - ./traefik.yml:/etc/traefik/dynamic_conf/conf.yml:ro
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
    deploy:
      update_config:
        order: stop-first
      placement:
        constraints:
          - node.role == manager
      labels:
        - traefik.enable=true
        # Redirect to HTTPS (excluding ACME challenge)
        - traefik.http.middlewares.redirect-to-https.redirectscheme.scheme=https
        - traefik.http.routers.redirs.rule=HostRegexp(`.+`) && !PathPrefix(`/.well-known/acme-challenge/`)
        - traefik.http.routers.redirs.entrypoints=web
        - traefik.http.routers.redirs.middlewares=redirect-to-https
        # Dashboard
        - traefik.http.routers.traefik.tls=true
        - traefik.http.routers.traefik.middlewares=admin
        - traefik.http.routers.traefik.service=api@internal
        - traefik.http.routers.traefik.rule=Host(`{{ SERVICE_URL }}`)
        - traefik.http.middlewares.admin.basicauth.users={{ TRAEFIK_BASIC_AUTH }}
        - traefik.http.services.traefik.loadbalancer.server.port=8080
        - traefik.swarm.network=traefik_overlay

networks:
  traefik_overlay:
    name: traefik_overlay
    external: true
